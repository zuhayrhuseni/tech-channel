# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# All three are free-tier-capable. Nothing else in the pipeline needs a key --
# Remotion, ffmpeg and whisper.cpp all run locally.

# --- ElevenLabs: the narration voice -----------------------------------------
# https://elevenlabs.io -> Profile (bottom-left avatar) -> API Keys -> Create.
# Starts with `sk_`. The pipeline uses the v3 model for its inline audio tags.
ELEVENLABS_API_KEY=sk_your_key_here

# The ID of YOUR cloned voice, NOT a stock voice name.
# Get it at https://elevenlabs.io/app/voice-lab -> your voice -> "ID" (copy icon),
# or `curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices`
# and read `voice_id`. It is a ~20-char alphanumeric string.
# See README "Cloning your voice" for how to create one.
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Pexels: b-roll video ----------------------------------------------------
# https://www.pexels.com/api/new/ -- free, instant, no card.
# Used to fetch the stock footage that sits behind the dark scrim.
PEXELS_KEY=your_pexels_key_here
